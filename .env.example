# Required for live Jev decisions. Leave empty to use simulation mode.
TYPESAFE_API_KEY=

# Optional overrides.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Laya-MLX runs as a separate Python service on Apple Silicon.
LAYA_BASE_URL=http://127.0.0.1:8090
# Must match LAYA_SERVER_API_KEY when the Laya service uses authentication.
LAYA_API_KEY=

PORT=8080
